<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Jaringan: API + aset web (mode https via androidScheme). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Kamera (PRD §9 — deklarasi Play Store, Sprint 8): preview scan AR
         getUserMedia di WebView + input file capture utk bukti misi.
         SEMENTARA (hanya saat jepret) dan TIDAK di latar belakang — tidak
         ada izin lain terkait kamera. Play Store: "Camera — scan sampah
         dengan AI & unggah bukti misi (opsional)". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required=false: aplikasi tetap terpasang di perangkat tanpa kamera
         (fitur scan ditangani state error + fallback galeri). -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Push FCM (Sprint 6/8): Android 13+ menuntut izin runtime
         POST_NOTIFICATIONS — diminta oleh plugin @capacitor/push-notifications
         saat pertama masuk app (di web/dev di-skip). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
