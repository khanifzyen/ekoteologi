# Base URL backend PocketBase (lihat pocketbase/README.md). Saat uji di
# perangkat via Wi-Fi: http://<IP-LAN-mesin-dev>:8090 (bukan localhost).
VITE_PB_URL=http://127.0.0.1:8090

# Google Sign-In (opsional). Kosong → tombol "Lanjut dengan Google" memberi
# pesan fitur belum aktif. Server juga wajib mengaktifkan provider google
# (env GOOGLE_CLIENT_ID/SECRET di pocketbase/.env.example).
# Redirect URI native (custom scheme) utk alur system browser + deep link
# (@capacitor/browser + @capacitor/app) — didaftarkan di Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_OAUTH_REDIRECT=
