ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://ekoteologi:ekoteologi@localhost:55432/ekoteologi
REDIS_URL=redis://localhost:56379/0
JWT_SECRET=ganti-dengan-secret-panjang-acak

# Token (Sprint 1): access pendek, refresh panjang (30 hari bila "Ingat saya").
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS_SHORT=1

# Rate limit login (per email+IP, Redis) — Sprint 1.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Google Sign-In (Sprint 1): Web Client ID dari Google Cloud Console.
# Sisi mobile: VITE_GOOGLE_CLIENT_ID. Tanpa nilai ini, /v1/auth/google → 503.
GOOGLE_CLIENT_ID=

# Penyimpanan avatar (dilayani statis di /uploads) — volume-kan di produksi.
UPLOAD_DIR=var/uploads
AVATAR_MAX_MB=2

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,capacitor://localhost,http://localhost

# ── LLM Scan (Sprint 2) — biaya nol saat dev (mock); model & key via env (PRD §4) ──
# mock (default) = MockProvider tanpa jaringan; live = provider vision OpenAI-compatible.
# Jika mode=live tapi konfigurasi belum lengkap, otomatis jatuh kembali ke mock.
LLM_MODE=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5

# ── Scan: kuota & cache (Sprint 2) ──
SCAN_DAILY_LIMIT=20
SCAN_IMAGE_MAX_MB=5
SCAN_CACHE_TTL_HOURS=24
SCAN_CACHE_SCHEMA=v1

# ── Misi (Sprint 4) ──
# Batas ukuran foto bukti misi (klaim photo → antrian verifikasi).
MISSION_IMAGE_MAX_MB=5

# ── Biaya LLM (dashboard admin, Sprint 4 — plan §5.3) ──
# Estimasi biaya per 1.000 token (satuan mata uang lokal, mis. IDR) dan budget
# bulanan (0 = belum ditetapkan). Mock mode tidak memakai token → biaya Rp0.
LLM_COST_PER_1K_TOKENS=0
LLM_BUDGET_MONTHLY=0

