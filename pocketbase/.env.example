# Konfigurasi PocketBase Ekoteologi (sprint 9) — salin ke .env (di-gitignore).
# Semua config via environment (konvensi repo) — PocketBase membaca env PB_* bawaan;
# env aplikasi dibaca di hook via $os.getenv.

# ── Superuser (inisialisasi: make pb-superuser / entrypoint compose) ──
# PB v0.40 tidak lagi membuat superuser otomatis dari env saat serve —
# kredensial dipakai `pocketbase superuser upsert` (lihat Makefile & Dockerfile).
PB_SUPERUSER_EMAIL=admin@ekoteologi.id
PB_SUPERUSER_PASSWORD=ekoteologi123

# ── HTTP ──
# Alamat listen bila tidak dipassing via flag (default 127.0.0.1:8090).
PB_LISTEN_ADDR=127.0.0.1:8090

# ── Identitas aplikasi (diekspos route GET /api/ekoteologi/ping) ──
EKO_APP_NAME=ekoteologi-backend
EKO_APP_VERSION=0.1.0-sprint12

# ── Meta aplikasi & rate limit (sprint 10 — migrasi settings bootstrap) ──
# URL publik aplikasi (untuk tautan email template PB) & pengirim email.
EKO_APP_URL=http://127.0.0.1:8090
EKO_SENDER_EMAIL=no-reply@ekoteologi.id

# ── Google OAuth2 (sprint 10) ──
# Bila keduanya terisi, migrasi settings bootstrap mengaktifkan provider
# "google" pada koleksi users (OAuth2 bawaan PB). Kosong → provider nonaktif
# (klien menampilkan pesan ramah, tanpa error).
# Redirect URI yang didaftarkan di Google Cloud Console:
#   web   : https://<host>/api/oauth2-redirect  (popup SDK)
#   native: <custom scheme aplikasi>, mis. id.ekoteologi.app://oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM scan (sprint 11 — keputusan M5 implementation-plan §2.1) ──
# (Estimasi biaya dashboard admin: LLM_COST_PER_1K_TOKENS (USD/1k token,
# default 0) & LLM_BUDGET_MONTHLY opsional — dipakai route dashboard sprint 13.)
LLM_COST_PER_1K_TOKENS=0
# LLM_BUDGET_MONTHLY=50

# mock (default dev/test, tanpa jaringan — item deterministik dari digest
# foto agar cache teruji end-to-end); live = 9Router self-hosted di VPS
# (OpenAI-compatible, hanya listen 127.0.0.1, tanpa API key eksternal).
LLM_MODE=mock
LLM_BASE_URL=http://127.0.0.1:20128/v1
# Model vision utk analisis foto + fallback bila model primer gagal total
# (timeout / 4xx-5xx / respons tidak lolos validasi). Contoh model vision:
#   glm/glm-4.6v, cmc/moonshotai/Kimi-K2.5  (lihat GET {LLM_BASE_URL}/models)
# Catatan: model reasoning butuh LLM_MAX_TOKENS lebih besar (mis. 4000),
# kalau tidak konten jawabannya bisa kosong (diperlakukan gagal → fallback).
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=500

# ── Scan: kuota harian, batas foto & cache (sprint 11 — PRD §2.2/§6) ──
SCAN_DAILY_LIMIT=20
SCAN_IMAGE_MAX_MB=5
SCAN_CACHE_TTL_HOURS=24

# ── Push FCM (sprint 13 — pb_hooks/push.pb.js) ──
# mode log (default): pesan push hanya dicatat di log server — aman tanpa
# kredensial. mode fcm: hook menukar JWT RS256 service account menjadi
# access token (di-cache ±1 jam) lalu POST {project}/messages:send; tanpa
# kredensial layak hook otomatis fallback ke mode log (fail-safe).
PUSH_MODE=log
# Service account Firebase dengan role "Firebase Cloud Messaging API Sender".
# Isi SALAH SATU: path file JSON, atau isi JSON langsung (di-env).
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
# ID project Firebase (domain-appspot.com atau id pendek).
FCM_PROJECT_ID=
# Override endpoint (khusus uji/integrasi; default endpoint Google):
# FCM_OAUTH_URL=https://oauth2.googleapis.com/token
# FCM_SEND_URL=https://fcm.googleapis.com/v1

# ── E-learning (sprint 13 — pb_hooks/elearning.pb.js) ──
# Ambang kelulusan kuis (%) & poin kuis (sekali per modul, via ledger).
QUIZ_PASS_PERCENT=70
QUIZ_POINTS=20

# ── Konten harian (sprint 13) ──
# Cron auto-publish: bila admin belum membuat baris utk hari ini, terbitkan
# satu dari bank quote terkurasi (idempoten). DAILY_CONTENT_AUTOPUBLISH=0
# mematikan (fallback tetap dilayani route).
DAILY_CONTENT_CRON=5 0 * * *
DAILY_CONTENT_AUTOPUBLISH=1

# ── Ops: backup & cleanup (sprint 13) ──
# Backup otomatis `pb_data` memakai fitur bawaan PocketBase (migrasi sprint
# 13 mengisi settings.backups dari env ini; retensi = arsip cron disimpan).
# BACKUP_ENABLED=0 mematikan; arsip terbaca di /api/backups + dasbor PB.
BACKUP_ENABLED=1
BACKUP_CRON=0 2 * * *
BACKUP_KEEP=7
# Cleanup kunci app_settings kedaluwarsa (sr:/scan_quota:/sd:/login_guard:/
# fcm:tk:) + entri llm_cache kadaluarsa. Trigger manual:
# POST /api/ekoteologi/cron/cleanup (admin).
CLEANUP_CRON=30 3 * * *

# ── Error reporting (sprint 13 — ops.pb.js) ──
# DSN Sentry (format https://<key>@<host>/<project>). Error TAK TERDUGA dari
# route (dan tubuh cron) dikirim best-effort; error bisnis 4xx tidak. Tanpa
# DSN: cukup log PocketBase.
SENTRY_DSN=

# ── Misi & gamifikasi (sprint 12) ──
# Batas foto bukti klaim misi photo (magic bytes JPG/PNG/WebP divalidasi hook).
MISSION_IMAGE_MAX_MB=5
# Bonus streak: +STREAK_BONUS_POINTS poin (lewat ledger source=streak) setiap
# kelipatan STREAK_BONUS_EVERY_DAYS hari aktif. 0 = bonus dimatikan.
STREAK_BONUS_POINTS=20
STREAK_BONUS_EVERY_DAYS=6
# Reminder streak (cron `STREAK_REMINDER_CRON`, default "0 8 * * *"): notif
# in-app utk user aktif kemarin yang belum aktif hari ini. STREAK_REMINDER=0
# mematikan pengiriman (cron tetap terdaftar). Push FCM + realtime aktif via
# pipeline notifikasi (sprint 13).
STREAK_REMINDER=1
STREAK_REMINDER_CRON=0 8 * * *
